PORT=4000

# Comma separated list of origins allowed to call this API.
# For local development with the included frontend, the default below is fine.
# For production, set this to your deployed frontend URL (e.g. https://transportex.vercel.app)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# MongoDB connection string.
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/transportex
# MongoDB Atlas (cloud):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/transportex?retryWrites=true&w=majority

# Optional: default admin account created automatically on first run
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@transportex.example
DEFAULT_ADMIN_PASSWORD=AdminPassword123